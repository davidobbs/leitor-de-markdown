{
"rewrites": [
{ "source": "/leitor/assets/:path*", "destination": "/assets/:path*" },
{ "source": "/leitor/icons/:path*", "destination": "/icons/:path*" },
{ "source": "/leitor/favicon.png", "destination": "/favicon.png" },
{ "source": "/leitor/favicon.svg", "destination": "/favicon.svg" },
{ "source": "/leitor/manifest.webmanifest", "destination": "/manifest.webmanifest" },
{ "source": "/leitor/sw.js", "destination": "/sw.js" },
{ "source": "/leitor/workbox-:hash*.js", "destination": "/workbox-:hash*.js" },
{ "source": "/((?!leitor/assets|leitor/icons|leitor/favicon\\.png|leitor/favicon\\.svg|leitor/manifest\\.webmanifest|leitor/sw\\.js|leitor/workbox-.*|assets|icons|favicon\\.svg|manifest\\.webmanifest|sw\\.js|workbox-.*).*)", "destination": "/index.html" }
],
"headers": [
{
"source": "/(.*)",
"headers": [
{ "key": "X-Content-Type-Options", "value": "nosniff" },
{ "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
]
},
{
"source": "/assets/(.*)",
"headers": [
{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
]
},
{
"source": "/leitor/assets/(.*)",
"headers": [
{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
]
}
]
}
